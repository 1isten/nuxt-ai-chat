{
  "name": "nuxt-ai-chat",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "server:generate": "esbuild server/index.ts --format=esm --platform=node --target=node20 --packages=external --bundle --minify --allow-overwrite --outfile=server/index.min.js",
    "prepackage": "shx rm -rf dist && shx rm -rf .output",
    "package": "cross-env NUXT_PUBLIC_API_BASE=http://localhost:18040 npm-run-all2 -s server:generate generate",
    "postpackage": "shx rm .output/nitro.json && shx mv .output/public .output/client && shx mkdir -p .output/server/db && shx cp server/index.min.js .output/server/index.js && shx cp -r server/db/migrations .output/server/db/migrations && shx mkdir .output/.github && shx cp -r .github/skills .output/.github/skills && shx mkdir .output/.data && shx cp -r test .output/test && shx mv .output/test/package.json .output/package.json && shx mv .output/test/README.md .output/README.md"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/gateway": "^3.0.104",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/vue": "^3.0.168",
    "@comark/nuxt": "^0.3.1",
    "@github/copilot-sdk": "^0.3.0",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.104",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.80",
    "@libsql/client": "^0.17.3",
    "@nuxt/ui": "^4.7.0",
    "@nuxthub/core": "^0.10.7",
    "@shikijs/langs": "^4.0.2",
    "@vercel/blob": "^2.3.3",
    "@vueuse/components": "^14.2.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "ai": "^6.0.168",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "motion-v": "^2.2.1",
    "nuxt": "^4.4.2",
    "nuxt-auth-utils": "^0.5.29",
    "nuxt-charts": "^2.1.4",
    "nuxt-csurf": "^1.6.5",
    "shiki": "^4.0.2",
    "striptags": "3.2.0",
    "tailwindcss": "^4.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^24.12.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "npm-run-all2": "^8.0.4",
    "shx": "^0.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.2.7"
  },
  "packageManager": "pnpm@10.33.2"
}
