# --- Copilot SDK refactor ---
# Path to the SQLite database file. Created on first run.
DB_PATH=./.data/ai.db
# Optional: GitHub OAuth/PAT token to authenticate Copilot CLI without
# `gh auth login`. Useful for headless / Electron environments.
# COPILOT_GITHUB_TOKEN=ghu_...
# Port for the standalone h3 server example (defaults to 18040).
PORT=18040
# When the SPA is hosted separately from the API, set this to the API origin.
# Empty string means "same origin".
NUXT_PUBLIC_API_BASE=http://localhost:18040

NUXT_PUBLIC_APP_TITLE=AI Assistant

# --- Legacy (commented-out modules; kept for reference) ---
# Password for nuxt-auth-utils (minimum 32 characters)
NUXT_SESSION_PASSWORD=
# GitHub OAuth client ID
NUXT_OAUTH_GITHUB_CLIENT_ID=
# GitHub OAuth client secret
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
# Vercel AI gateway key
AI_GATEWAY_API_KEY=
# Blob read write token
BLOB_READ_WRITE_TOKEN=
# Turso database URL (not needed for local development)
TURSO_DATABASE_URL=
# Turso auth token (not needed for local development)
TURSO_AUTH_TOKEN=
